# .env.staging.example - modelo do ambiente de STAGING (QA remoto).
# Copie para `.env.staging` NO SERVIDOR e preencha. `.env.staging` e ignorado
# pelo git; nenhum valor real pode ser commitado.

# Banco de staging (container proprio, sem porta publica)
POSTGRES_USER=staging360
POSTGRES_PASSWORD=replace-with-a-staging-only-password
POSTGRES_DB=pesquisa360_staging
DATABASE_URL=postgresql://staging360:replace-with-a-staging-only-password@db:5432/pesquisa360_staging

# Ambiente. `staging` mantem /docs e permite o seed QA; NAO usar `production`.
APP_ENV=staging

# Seguranca (gerar um valor proprio de staging; nunca reutilizar o de producao)
SECRET_KEY=
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=30

# Bind da API no host (o nginx faz o HTTPS). Nao expor 0.0.0.0.
STAGING_API_BIND=127.0.0.1
STAGING_API_PORT=8010

# CORS: so importa para o Web em staging (app nativo nao passa por CORS).
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Upload
UPLOAD_MAX_SIZE_BYTES=10485760
UPLOAD_DIRECTORY=/app/uploads

# Limites defensivos
P360_CROSS_MAX_DIMENSIONS=8
P360_CROSS_MAX_NODES=5000
P360_CROSS_MAX_COMBINATIONS=100000

# E-mail: sem SMTP_HOST o envio fica em modo REGISTRO (nada e entregue).
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@pesquisa360.local
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15
WEB_BASE_URL=http://localhost:5173

# Atras do nginx com X-Forwarded-For: pode ser `true` (ADR-039).
AUDIT_TRUST_PROXY=true

# Seed QA (NAO colocar aqui em ambiente compartilhado; passar no comando ou
# como secret do CI). Listados so para inventario de nomes:
# CONFIRM_QA_SEED=SEED_QA_DATASET
# QA_DEFAULT_PASSWORD=
