# .env.example
# Configuracoes do Banco de Dados
POSTGRES_USER=user360
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=pesquisa360_db
DATABASE_URL=postgresql://user360:replace-with-a-local-password@db:5432/pesquisa360_db

# Ambiente de execucao (ADR-038)
# development (default): /docs, /redoc e /openapi.json disponiveis.
# production: as tres rotas NAO sao registradas (404).
# O deploy de PRODUCAO precisa definir isto explicitamente -- nao ha inferencia
# por hostname, dominio ou porta.
APP_ENV=development

# Configuracoes de Seguranca
SECRET_KEY=
# TTL do access token, em minutos. Curto de proposito: a expiracao normal e
# absorvida pelo refresh, nao por um access praticamente eterno.
ACCESS_TOKEN_EXPIRE_MINUTES=480
# TTL do refresh token, em dias. Deve ser bem maior que o do access.
REFRESH_TOKEN_EXPIRE_DAYS=30

# Configuracoes de CORS
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Configuracoes de Upload
UPLOAD_MAX_SIZE_BYTES=10485760
UPLOAD_DIRECTORY=/app/uploads

# Limites defensivos do cruzamento multidimensional
P360_CROSS_MAX_DIMENSIONS=8
P360_CROSS_MAX_NODES=5000
P360_CROSS_MAX_COMBINATIONS=100000

# Envio de e-mail transacional (convite de ativacao de conta).
# Sem SMTP_HOST o envio fica em modo REGISTRO: nada e entregue e o log avisa.
# Nenhuma credencial real deve ser commitada aqui.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=nao-responda@pesquisa360.local
SMTP_USE_TLS=true
SMTP_TIMEOUT_SECONDS=15

# Base publica do painel Web, usada para montar o link de ativacao.
WEB_BASE_URL=http://localhost:5173

# Auditoria (ADR-039). So habilite atras de um reverse proxy confiavel: com
# isto ligado, o IP do evento vem do primeiro endereco de X-Forwarded-For.
AUDIT_TRUST_PROXY=false

# --- Apuracao TSE: ingestor automatico (servico tse_ingestor) -----------------
# DESLIGADO por padrao: o container sobe ocioso e nao consulta o TSE.
TSE_INGESTION_ENABLED=false
# OFICIAL ou SIMULADO (ambiente de simulacao do TSE). Producao: OFICIAL.
TSE_INGESTION_ORIGIN=OFICIAL
# UFs separadas por virgula. Obrigatoria quando habilitado.
TSE_INGESTION_UFS=AP
# 0001 Presidente, 0003 Governador, 0005 Senador, 0006 Dep. Federal, 0007 Dep. Estadual
TSE_INGESTION_CARGOS=0001,0003,0005,0006,0007
# Municipios com resultado proprio: "todos" ou codigos TSE de 5 digitos.
TSE_INGESTION_MUNICIPIOS=todos
# Municipios cujas ZONAS tambem sao ingeridas: vazio, "todos" ou codigos.
TSE_INGESTION_ZONAS_DE=
# Intervalo entre ciclos, em segundos (15 a 3600).
TSE_INGESTION_INTERVAL_SECONDS=20
# Teto de requisicoes por segundo ao TSE (o servico recusa mais de 10).
TSE_REQUESTS_PER_SECOND=2
# Opcional: fixa o pleito. Vazio = descoberto no EA11.
TSE_INGESTION_PLEITO=
# Boletins de Urna (resultado por SECAO). DESLIGADO por padrao, mesmo com a
# ingestao ligada: e carga adicional (ate 2 requisicoes por secao) e deve ser
# habilitado por ambiente. Exige o banco no head atual (tabelas tse_bu_*).
TSE_INGESTION_BU_ENABLED=false
# Secoes verificadas por UF a cada ciclo (1 a 500).
TSE_INGESTION_BU_BATCH_SIZE=50
# "todos" ou codigos TSE dos municipios cujas secoes entram.
TSE_INGESTION_BU_MUNICIPIOS=todos
# Opcional: diretorio para guardar os arquivos originais (nome = SHA-256).
TSE_INGESTION_BU_ARCHIVE_DIR=
